{
  "name": "openui-convex",
  "version": "0.1.0",
  "description": "Durable, reactive OpenUI interface state on Convex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayush962/openui-convex.git"
  },
  "homepage": "https://github.com/aayush962/openui-convex#readme",
  "bugs": {
    "url": "https://github.com/aayush962/openui-convex/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "sideEffects": false,
  "keywords": [
    "convex",
    "component",
    "openui",
    "generative-ui",
    "agent"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "predev": "convex init && npm run build:codegen && npm run gen:spec",
    "dev": "convex dev --typecheck-components --start 'npm run dev:build'",
    "dev:frontend": "vite --config example/vite.config.ts",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.{ts,tsx}' -i '**/*.test.*' -i '**/_generated/**' -c 'npm run build:codegen' --initial",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "build:example": "npm run build && npm run gen:spec && vite build --config example/vite.config.ts",
    "gen:spec": "OPENUI_TELEMETRY_DISABLED=1 openui generate ./example/src/library/index.ts --out ./example/convex/generated/system-prompt.txt",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "check": "npm run build && npm run typecheck && npm run lint && npm test && npm run build:example && npm run check:exports",
    "check:exports": "node scripts/check-exports.mjs",
    "pack:check": "npm run check && npm pack --dry-run",
    "deploy:example": "convex deploy --cmd 'npm run build:example' --cmd-url-env-var-name VITE_CONVEX_URL",
    "prepare": "npm run build",
    "preversion": "pnpm install --frozen-lockfile && npm run build:clean && npm run typecheck && npm run lint && npm test",
    "version": "(npm whoami || npm login) && node scripts/changelog.mjs && git add CHANGELOG.md",
    "alpha": "npm version prerelease --preid alpha && npm publish --tag alpha && git push --follow-tags",
    "release": "npm version patch && npm publish && git push --follow-tags"
  },
  "peerDependencies": {
    "convex": "^1.43.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.52",
    "@convex-dev/agent": "0.7.2",
    "@convex-dev/eslint-plugin": "4.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "9.39.5",
    "@openuidev/cli": "0.2.13",
    "@openuidev/lang-core": "0.2.18",
    "@openuidev/react-headless": "0.9.13",
    "@openuidev/react-lang": "0.2.15",
    "@openuidev/react-ui": "0.13.10",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.97",
    "chokidar-cli": "3.0.0",
    "convex": "1.45.0",
    "convex-helpers": "0.1.124",
    "convex-test": "0.0.57",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "zod": "4.6.1",
    "zustand": "^4.5.5"
  }
}
